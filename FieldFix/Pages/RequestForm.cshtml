@page
@model FieldFix.Pages.RequestFormModel
@{
    ViewData["Title"] = "Create Request";
}

<div class="form-shell">
    <div class="page-header compact">
        <div>
            <p class="eyebrow">New Entry</p>
            <h1>Create Service Request</h1>
        </div>
    </div>

    <form method="post" class="request-form">
        <div class="form-grid">
            <div>
                <label asp-for="Input.Title">Title</label>
                <input asp-for="Input.Title" />
                <span asp-validation-for="Input.Title"></span>
            </div>

            <div>
                <label asp-for="Input.Location">Location</label>
                <input asp-for="Input.Location" />
                <span asp-validation-for="Input.Location"></span>
            </div>

            <div>
                <label asp-for="Input.Category">Category</label>
                <select asp-for="Input.Category">
                    <option>Infrastructure</option>
                    <option>Equipment</option>
                    <option>Safety</option>
                    <option>Power</option>
                </select>
            </div>

            <div>
                <label asp-for="Input.Priority">Priority</label>
                <select asp-for="Input.Priority">
                    <option>Low</option>
                    <option selected>Medium</option>
                    <option>High</option>
                    <option>Critical</option>
                </select>
            </div>

            <div>
                <label asp-for="Input.RequestedBy">Requested By</label>
                <input asp-for="Input.RequestedBy" />
            </div>

            <div>
                <label asp-for="Input.AssignedTo">Assigned To</label>
                <input asp-for="Input.AssignedTo" value="Unassigned" />
            </div>
        </div>

        <div class="textarea-wrap">
            <label asp-for="Input.Description">Description</label>
            <textarea asp-for="Input.Description" rows="5"></textarea>
            <span asp-validation-for="Input.Description"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary-btn">Submit Request</button>
            <a asp-page="/Requests" class="secondary-btn">View Requests</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
